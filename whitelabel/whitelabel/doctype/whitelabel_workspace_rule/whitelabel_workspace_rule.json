{
  "doctype": "DocType",
  "name": "Whitelabel Workspace Rule",
  "module": "Whitelabel",
  "engine": "InnoDB",
  "field_order": [
    "title",
    "enabled",
    "applies_to",
    "role",
    "role_profile",
    "workspace",
    "sidebar",
    "priority"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "applies_to",
      "label": "Applies To",
      "fieldtype": "Select",
      "options": "Role\nRole Profile",
      "default": "Role",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "role",
      "label": "Role",
      "fieldtype": "Link",
      "options": "Role",
      "depends_on": "eval:doc.applies_to === \"Role\"",
      "mandatory_depends_on": "eval:doc.applies_to === \"Role\""
    },
    {
      "fieldname": "role_profile",
      "label": "Role Profile",
      "fieldtype": "Link",
      "options": "Role Profile",
      "depends_on": "eval:doc.applies_to === \"Role Profile\"",
      "mandatory_depends_on": "eval:doc.applies_to === \"Role Profile\""
    },
    {
      "fieldname": "workspace",
      "label": "Workspace",
      "fieldtype": "Link",
      "options": "Workspace",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sidebar",
      "label": "Preferred Sidebar",
      "fieldtype": "Link",
      "options": "Workspace Sidebar",
      "description": "Must be shared and contain the workspace. Leave empty to select an available sidebar."
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Int",
      "default": "100",
      "description": "Lower numbers win within Role Profile or Role rules. Equal priorities sort by rule name."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "field:title",
  "title_field": "title"
}
