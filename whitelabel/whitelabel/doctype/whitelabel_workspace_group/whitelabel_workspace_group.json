{
  "doctype": "DocType",
  "name": "Whitelabel Workspace Group",
  "module": "Whitelabel",
  "engine": "InnoDB",
  "field_order": [
    "title",
    "enabled",
    "icon",
    "sequence",
    "include_module",
    "workspaces"
  ],
  "fields": [
