    {
      "fieldname": "route_root_to_workspace",
      "label": "Use Site Root for Desk Login and Home",
      "fieldtype": "Check",
      "default": "0",
      "depends_on": "enable_workspace_navigation",
      "description": "At /, guests go to login and signed-in System Users go Home. Signed-in Website Users retain native website/portal routing. Leave off for a public website."
    },
    {
      "fieldname": "allow_user_workspace_home",
      "label": "Allow Users to Choose Their Home",
      "fieldtype": "Check",
      "default": "1",
      "depends_on": "enable_workspace_navigation",
      "description": "Allows System Users to set their own Default Workspace. Existing user defaults remain the first choice."
    },
