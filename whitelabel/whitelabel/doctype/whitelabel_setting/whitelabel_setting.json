      "fieldname": "navigation_configuration",
      "label": "Configuration",
      "fieldtype": "HTML",
      "depends_on": "enable_workspace_navigation"
    },
    {
      "fieldname": "desk_layout",
      "label": "Desk Layout",
      "fieldtype": "Select",
      "options": "Standard\nClassic",
      "default": "Standard",
      "depends_on": "enable_workspace_navigation",
      "description": "Classic shows a persistent workspace tree defined by Navigation Profiles."
    },
    {
      "fieldname": "default_navigation_profile",
      "label": "Default Navigation Profile",
      "fieldtype": "Link",
      "options": "Whitelabel Navigation Profile",
      "depends_on": "eval:doc.enable_workspace_navigation && doc.desk_layout == \"Classic\"",
      "description": "Used only when no enabled profile is assigned to this user or their roles. No modules are added automatically."
    },
    {
      "fieldname": "show_personal_workspaces",
